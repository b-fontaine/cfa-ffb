rules_version='2'

// Refus par défaut (ADR 0024, A9). Les règles par rôle arrivent avec FB3 et
// leurs tests contre l'émulateur ; tant qu'elles n'existent pas, rien n'est lisible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
