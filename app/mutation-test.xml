<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.2">
  <!-- Mutation testing déterministe (package mutation_test).
       Lancé via scripts/check.sh --full ou scripts/mutation.sh (copie temporaire
       de app/, jamais l'arbre de travail). Les tests tagués `tooling`
       (scripts shell, voir dart_test.yaml) sont exclus : sans rapport avec lib/. -->
  <files>
    <file>lib/**.dart</file>
  </files>
  <exclude>
    <!-- Code généré -->
    <file>lib/**.g.dart</file>
    <file>lib/**.freezed.dart</file>
    <file>lib/**.config.dart</file>
    <file>lib/**.steps.dart</file>
    <directory>lib/shared/l10n/generated</directory>
    <!-- Point d'entrée et câblage : couverts par les tests BDD, pas par mutation -->
    <file>lib/main.dart</file>
    <file>lib/app/di/injection.dart</file>
  </exclude>
  <commands>
    <command group="test" expected-return="0" working-directory="." timeout="180">flutter test --no-pub --reporter failures-only --fail-fast -x tooling</command>
  </commands>
  <threshold failure="85"/>
</mutations>
